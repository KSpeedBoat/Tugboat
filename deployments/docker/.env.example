# PostgreSQL
POSTGRES_DB=tugboat
POSTGRES_USER=tugboat
POSTGRES_PASSWORD=tugboat_secret
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
